{
  "source_dirs": [
    "src"
  ],
  "layout": "<one line, in this project's own words, on how code is organized today; feature folders under feature_root are the recommendation, never a requirement>",
  "feature_root": "src/features",
  "areas": {},
  "map_dirs": [],
  "generated_patterns": [],
  "code_extensions": [
    ".py",
    ".ts",
    ".tsx",
    ".js",
    ".jsx",
    ".mjs",
    ".go",
    ".rs",
    ".java",
    ".kt",
    ".cs",
    ".rb",
    ".php",
    ".swift",
    ".dart"
  ],
  "test_patterns": [
    "**/tests/**",
    "**/test/**",
    "**/__tests__/**",
    "**/test_*",
    "**/*_test.*",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*_spec.*",
    "**/*Test.*",
    "**/*Tests.*",
    "**/*Spec.*"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/.venv/**",
    "**/venv/**",
    "**/dist/**",
    "**/build/**",
    "**/target/**",
    "**/.next/**",
    "**/vendor/**",
    "**/__pycache__/**",
    "**/*.lock",
    "**/package-lock.json",
    "**/*.min.*"
  ],
  "limits": {
    "module_lines": 500,
    "test_lines": 1200,
    "feature_map_lines": 20,
    "id_header_lines": 15,
    "files_per_dir": 20,
    "skill_md_bytes": 6144
  },
  "banned_names": [
    "helpers",
    "utils",
    "shared",
    "common",
    "misc",
    "state"
  ],
  "unique_name_exempt": [
    "__init__",
    "index",
    "main",
    "mod",
    "conftest",
    "setup",
    "types",
    "page",
    "layout",
    "route"
  ],
  "id_pattern": "\\b[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*-\\d+\\b",
  "allowlist": {
    "long_modules": {},
    "long_tests": {},
    "banned_names": [],
    "duplicate_names": [],
    "no_prd_id": [],
    "untested_rules": [],
    "no_feature_map": [],
    "long_feature_maps": {},
    "crowded_dirs": {},
    "skill_md_bytes": {
      ".claude/skills/prd-create/SKILL.md": 8244,
      ".claude/skills/trd-create/SKILL.md": 8218
    },
    "generated_without_marker": [],
    "invariant_gaps": 0
  },
  "ratchet": {
    "skip": []
  },
  "contracts": [],
  "commands": {
    "test": "<test runner, for example: uv run pytest>",
    "offline_args": "<args that exclude the integration tier, for example: --ignore=tests/integration>",
    "integration_args": "<args for the integration tier, for example: tests/integration>",
    "no_coverage_args": "<args that disable the coverage threshold, for example: --no-cov>",
    "lint": "<verify only, for example: uv run ruff check . && uv run ruff format --check . && uv run mypy src>",
    "fix": "<repair, for example: uv run ruff check --fix . && uv run ruff format .>",
    "fix_file": "<repair only the given files, {files} is replaced by the paths, for example: uv run ruff check --fix {files} && uv run ruff format {files}>",
    "lint_file": "<verify only the given files, {files} is replaced by the paths, for example: uv run ruff check {files} && uv run ruff format --check {files}>",
    "import_check": "<catches import cycles, for example: uv run python -c \"import main\">",
    "setup": "<makes a fresh clone or worktree ready to test, for example: uv sync --frozen>",
    "offline_unset": [
      "DATABASE_URL"
    ],
    "offline_flag": "OFFLINE_ONLY",
    "python": "",
    "project_targets": []
  },
  "tests": {
    "runner": "<runs the given test files offline without coverage, for example: uv run pytest {files} --no-cov -q>",
    "native_related": "",
    "failure_regex": "^(?:FAILED|ERROR)\\s+(\\S+)",
    "summary_regex": "",
    "fast_flags": [],
    "test_dirs": [],
    "log_dir": ".claude/prd-flow/state/_tests",
    "mirror_patterns": [
      "test_{name}",
      "{name}_test",
      "{name}_spec",
      "{name}.test",
      "{name}.spec",
      "{name}Test",
      "{name}Tests",
      "{name}Spec",
      "{name}IT"
    ],
    "match_symbol": false,
    "related_budget_seconds": 60,
    "junit_xml": "",
    "flaky": [],
    "baseline_deselect": [],
    "baseline_idle_seconds": 300,
    "always": [],
    "related_exclude": [],
    "snapshot_patterns": [
      "**/__snapshots__/**",
      "**/*.snap",
      "**/*.golden",
      "**/*.verified.*",
      "**/*.approved.*"
    ]
  },
  "telemetry": {
    "long_call_s": 300,
    "long_test_s": 300,
    "long_subagent_min": 30,
    "subagent_tokens": 150000,
    "subagent_tools": 50,
    "context_peak_tokens": 200000,
    "big_output_kb": 20,
    "loop_repeats": 3,
    "edit_repeats": 8,
    "error_rate": 0.15,
    "memory_mb": 2048,
    "disk_drop_mb": 1024,
    "dead_mb": 500,
    "max_events_mb": 5,
    "keep_days": 14,
    "doc_reads": 3,
    "kpi_main_calls": 30,
    "kpi_inline_reads": 0,
    "kpi_gate_runs_main": 2,
    "kpi_parallel_factor_min": 1.5
  }
}
