{
  "source_dirs": ["src"],
  "feature_root": "src/features",
  "code_extensions": [".py", ".ts", ".tsx", ".js", ".jsx", ".mjs", ".go", ".rs", ".java", ".kt", ".cs", ".rb", ".php", ".swift", ".dart"],
  "test_patterns": ["**/tests/**", "**/test/**", "**/__tests__/**", "**/test_*", "**/*_test.*", "**/*.test.*", "**/*.spec.*", "**/*_spec.*"],
  "ignore": ["**/node_modules/**", "**/.venv/**", "**/venv/**", "**/dist/**", "**/build/**", "**/target/**", "**/.next/**", "**/vendor/**", "**/__pycache__/**"],
  "limits": {
    "module_lines": 500,
    "test_lines": 1200,
    "feature_map_lines": 20,
    "id_header_lines": 15
  },
  "banned_names": ["helpers", "utils", "shared", "common", "misc", "state"],
  "unique_name_exempt": ["__init__", "index", "main", "mod", "conftest", "setup", "types", "page", "layout", "route"],
  "id_pattern": "\\b[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*-\\d+\\b",
  "allowlist": {
    "long_modules": {},
    "long_tests": {},
    "banned_names": [],
    "duplicate_names": [],
    "no_prd_id": [],
    "no_feature_map": [],
    "long_feature_maps": {}
  },
  "tests": {
    "runner": "<command that runs the given test files without coverage, for example: uv run pytest {files} --no-cov -q>",
    "native_related": "",
    "failure_regex": "^(?:FAILED|ERROR)\\s+(\\S+)",
    "log_dir": ".claude/prd-gate/state/_tests"
  }
}
